{
  "manifest_version": 3,
  "name": "GitHub 加速 · 智能节点版",
  "version": "2.8.0",
  "description": "内置 80+ 公益加速节点；一键体检自动完成同步、去重、测速与能力标注；智能模式把可加速仓库的节点用于打开仓库 / clone，仅下载节点留给文件下载；界面主色实时跟随浏览器 / 系统主题色，Material You 深浅双主题、jsDelivr CDN 通道与登录保护；GitHub 打不开时自动走加速节点代理。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "GitHub 加速",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options/options.html",
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "webNavigation", "scripting"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["*://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/store.js",
        "lib/nodes.js",
        "lib/net.js",
        "lib/rank.js",
        "lib/repos.js",
        "lib/routes.js",
        "lib/theme.js",
        "lib/ui.js"
      ],
      "matches": ["*://github.com/*"]
    }
  ]
}
